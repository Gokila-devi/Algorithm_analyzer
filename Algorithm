import java.util.Arrays;
import java.util.Random;
import java.util.Scanner;

public class algo {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter number of elements: ");
        int n = sc.nextInt();

        int[] arr1 = new int[n];
        Random random = new Random();

        for (int i = 0; i < n; i++) {
            arr1[i] = random.nextInt(100000);
        }

        int[] arr2 = arr1.clone();

        // Bubble Sort Performance
        long start = System.nanoTime();
        bubbleSort(arr1);
        long end = System.nanoTime();
        long bubbleTime = end - start;

        // Java's built-in sorting performance
        start = System.nanoTime();
        Arrays.sort(arr2);
        end = System.nanoTime();
        long quickTime = end - start;

        System.out.println("\n--- Algorithm Performance Analyzer ---");
        System.out.println("Number of elements: " + n);
        System.out.println("Bubble Sort Time: " + bubbleTime + " ns");
        System.out.println("Arrays.sort() Time: " + quickTime + " ns");

        if (bubbleTime < quickTime) {
            System.out.println("Faster Algorithm: Bubble Sort");
        } else {
            System.out.println("Faster Algorithm: Arrays.sort()");
        }

        sc.close();
    }

    static void bubbleSort(int[] arr) {
        int n = arr.length;

        for (int i = 0; i < n - 1; i++) {
            boolean swapped = false;

            for (int j = 0; j < n - i - 1; j++) {
                if (arr[j] > arr[j + 1]) {
                    int temp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = temp;
                    swapped = true;
                }
            }

            if (!swapped) {
                break;
            }
        }
    }
}
